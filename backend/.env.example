# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── External APIs ─────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-5

# ── Auth ──────────────────────────────────────────────────────────────────────
# Must be at least 32 characters for production
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars_long_random

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# DEV:  http://localhost:5173
# PROD: https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# DEV — Gmail SMTP:
#   1. myaccount.google.com → Security → 2-Step Verification (enable)
#   2. myaccount.google.com → Security → App Passwords
#   3. Generate 16-char App Password → paste as SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail_address@gmail.com
SMTP_PASS=your_16_char_gmail_app_password

# PROD — SendGrid (recommended):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=apikey
# SMTP_PASS=your_sendgrid_api_key

# PROD — AWS SES:
# SMTP_HOST=email-smtp.<region>.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_ses_smtp_username
# SMTP_PASS=your_ses_smtp_password

# Sender display name (must match your verified SMTP domain in prod)
EMAIL_FROM="TFI_CONNECTS" <your_email@domain.com>

# ── Frontend URL (used in email links) ───────────────────────────────────────
# DEV:  http://localhost:5173
# PROD: https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173
